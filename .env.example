# Copy to .env and fill in. .env is gitignored; never commit real passwords.
# Generate each with: openssl rand -hex 32

# Alembic migrations run as the schema owner.
DATABASE_URL=postgresql+psycopg2://mos_owner:CHANGE_ME_OWNER@localhost/mosferics

# The pipeline modules run as mos_pipeline, which cannot run DDL or edit raw.
PIPELINE_DATABASE_URL=postgresql+psycopg2://mos_pipeline:CHANGE_ME_PIPELINE@localhost/mosferics

# Database tests: a scratch database migrated to head. Unset, they are skipped.
# TEST_DATABASE_URL=postgresql+psycopg2://mos_pipeline:CHANGE_ME_PIPELINE@localhost/mosferics_scratch
